 {
  "expo": {
    "name": "StudySpace KNUST",
    "slug": "studyspace-knust",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "scheme": "studyspaceknust",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.knust.studyspace",
      "buildNumber": "1",
      "icon": "./assets/icon.png",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "StudySpace needs your location to verify you are inside the library before you report or claim a seat.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "StudySpace needs your location to verify you are inside the library before you report or claim a seat.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.knust.studyspace",
      "versionCode": 1,
      "icon": "./assets/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "StudySpace needs your location to verify you are inside the library before you report or claim a seat."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#16a34a"
        }
      ],
      "expo-asset",
      "expo-status-bar"
    ],
    "extra": {
      "eas": {
        "projectId": "d804fee4-5016-4351-a0f5-a7e2ca17e858"
      }
    },
    "owner": "starturn.09",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/d804fee4-5016-4351-a0f5-a7e2ca17e858"
    }
  }
}