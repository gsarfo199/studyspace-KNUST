  rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function isAdmin() { return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    match /libraries/{libId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /reports/{id} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid && request.resource.data.availableSeats >= -1 && request.resource.data.availableSeats <= 1000;
      allow update, delete: if false;
    }
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['karma','isPremium','trustScore','extraWatches']);
      allow delete: if false;
    }
    match /queue/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if false;
    }
    match /leavingAssignments/{id} {
      allow read: if isSignedIn();
      allow create: if isAdmin();
      allow update: if isSignedIn() && resource.data.assignedTo == request.auth.uid;
      allow delete: if false;
    }
    match /watchlist/{id} { allow read: if isSignedIn(); allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid; allow delete: if isSignedIn() && resource.data.userId == request.auth.uid; allow update: if false; }
    match /payments/{id} { allow read: if isSignedIn(); allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid; allow update, delete: if isAdmin(); }
    match /leavingReports/{id} { allow read: if isSignedIn(); allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid; allow update, delete: if false; }
    match /admins/{id} { allow read: if isAdmin(); allow write: if false; }
  }
}