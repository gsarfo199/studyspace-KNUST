{
  "expo": {
    "name": "StudySpace KNUST",
    "slug": "studyspace-knust",
    "ios": {
      "bundleIdentifier": "com.knust.studyspace",
      "useFrameworks": "static"
    },
    "android": {
      "package": "com.knust.studyspace",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow StudySpace to verify you are inside library #10 #35 #65"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#16a34a"
        }
      ],
      "expo-asset",
      "expo-status-bar"
    ],
    "extra": {
      "eas": {
        "projectId": "d804fee4-5016-4351-a0f5-a7e2ca17e858"
      }
    },
    "owner": "starturn.09"
  }
}
